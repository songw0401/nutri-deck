# 공공데이터포털(data.go.kr) 15143502 메뉴젠 Open API 서비스키
# 실제 키는 backend/.env에만 입력하고 GitHub에는 올리지 않습니다.
DATA_GO_KR_SERVICE_KEY=여기에_서비스키_입력

# API 한 페이지 요청 건수 (1~100)
MENUZEN_PAGE_SIZE=20

# true: FastAPI 서버 시작 시 메뉴젠 Open API를 다시 수집해 게임 데이터를 갱신
# false: 마지막으로 검증된 캐시를 즉시 사용 (로컬/발표 시 권장)
SYNC_MENUZEN_ON_STARTUP=false

# true일 때만 POST /api/data/sync 활성화. 외부 배포에서는 false 권장.
ENABLE_DATA_SYNC_ENDPOINT=false
